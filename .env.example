# ==============================================================================
# X-Ray to CT Image Translation System - Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="X-Ray to CT Image Translation System"
API_PREFIX=/api/v1

# Security & Authentication
# IMPORTANT: Replace with a cryptographically secure 256-bit secret in production
JWT_SECRET=super_secret_dev_key_change_me_in_production_min_32_characters_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# PostgreSQL format: postgresql+asyncpg://user:password@localhost:5432/xray_ct_db
# Default SQLite fallback allows out-of-the-box local testing without running PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./xray_ct.db
DATABASE_URL_SYNC=sqlite:///./xray_ct.db

# Storage Configuration
# Storage backend: local | s3 | minio
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage
# AWS / MinIO S3 Configuration (Optional if STORAGE_TYPE=s3)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=xray-ct-storage
S3_REGION=us-east-1

# Redis Cache / Task Queue (Optional in dev, required for Celery / async worker mode)
REDIS_URL=redis://localhost:6379/0

# Machine Learning Model Configuration
MODEL_DIR=./models
ACTIVE_MODEL_VERSION=v1
ACTIVE_MODEL_PATH=./models/v1/generator.pth
DEVICE=auto
IMAGE_SIZE=256
BATCH_SIZE=1

# File Upload Constraints
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=png,jpg,jpeg,dcm
ALLOWED_MIME_TYPES=image/png,image/jpeg,application/dicom

# Experiment Tracking (Optional)
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=xray_to_ct_translation

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
