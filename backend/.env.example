ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="X-Ray to CT Translation API"
API_PREFIX=/api/v1
JWT_SECRET=super_secret_dev_key_change_me_in_production_min_32_characters_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite+aiosqlite:///./xray_ct.db
DATABASE_URL_SYNC=sqlite:///./xray_ct.db
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage
REDIS_URL=redis://localhost:6379/0
MODEL_DIR=../models
ACTIVE_MODEL_VERSION=v1
ACTIVE_MODEL_PATH=../models/v1/generator.pth
DEVICE=auto
IMAGE_SIZE=256
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=png,jpg,jpeg,dcm
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
